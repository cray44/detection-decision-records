{
  "id": "det-lolbin-regsvr32-001",
  "displayName": "LOLBin regsvr32 suspicious parent process",
  "description": "Detects regsvr32.exe spawned by suspicious parent processes.",
  "queryCondition": "DeviceProcessEvents\n| where FileName =~ \"regsvr32.exe\"\n| where not (InitiatingProcessAccountName has_any (\"svc-patching\", \"svc-deploy\"))",
  "queryFrequency": "PT1H",
  "queryPeriod": "P1D",
  "severity": "Medium",
  "isEnabled": true,
  "detectionAction": {
    "alertTitle": "Suspicious regsvr32.exe execution",
    "category": "SuspiciousActivity",
    "recommendedActions": "Investigate the process tree."
  },
