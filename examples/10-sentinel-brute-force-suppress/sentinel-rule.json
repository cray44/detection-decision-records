{
  "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-sentinel/providers/Microsoft.OperationalInsights/workspaces/corp-sentinel/providers/Microsoft.SecurityInsights/alertRules/sign-ins-from-ips-disabled-accounts",
  "name": "sign-ins-from-ips-disabled-accounts",
  "type": "Microsoft.SecurityInsights/alertRules",
  "etag": "\"00001234-0000-0200-0000-662abc120000\"",
  "systemData": {
    "createdAt": "2024-03-01T10:00:00Z",
