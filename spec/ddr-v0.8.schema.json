  "additionalProperties": false,
  "description": "Top-level Detection Decision Record. Pydantic model is source of truth for JSON Schema.",
  "properties": {
    "ddr_version": {
      "pattern": "^0\\.[12345678]$",
      "title": "Ddr Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "target": {
      "discriminator": {
        "mapping": {
          "elastic": "#/$defs/ElasticTarget",
          "kql-m365d": "#/$defs/KqlM365DTarget",
          "kql-sentinel": "#/$defs/KqlSentinelTarget",
          "sigma": "#/$defs/SigmaTarget",
          "splunk": "#/$defs/SplunkTarget"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SigmaTarget"
        },
        {
          "$ref": "#/$defs/SplunkTarget"
        },
        {
          "$ref": "#/$defs/ElasticTarget"
        },
        {
          "$ref": "#/$defs/KqlSentinelTarget"
        },
        {
          "$ref": "#/$defs/KqlM365DTarget"
        }
      ],
      "title": "Target"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "decision": {
      "discriminator": {
